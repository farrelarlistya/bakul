# Salin ke .env lalu ganti password. Jangan commit .env.

# PostgreSQL native lokal
DATABASE_URL="postgresql://bakul:GANTI_PASSWORD@127.0.0.1:5432/bakul_dev?schema=public"

# API NestJS
API_PORT=3001
NODE_ENV=development

# Mode demo: OTP 123456 tampil di Inbox dan data seed boleh dipakai.
DEMO_MODE=true
DEMO_SPEED=60

# Penyedia tiruan (dipakai mulai Sprint 4)
PAYMENT_PROVIDER=mock
LOGISTICS_PROVIDER=mock
NOTIFIER_PROVIDER=mock
STORAGE_PROVIDER=local

# Rahasia lokal. Isi dengan nilai acak 64 karakter hex, jangan pakai nilai contoh.
AUTH_JWT_ACCESS_SECRET="isi_dengan_64_karakter_hex"
OTP_PEPPER="isi_dengan_64_karakter_hex"
AUTH_REFRESH_DAYS=7

# Rahasia tahap berikutnya.
MOCK_PG_SECRET="isi_dengan_rahasia_webhook_lokal"
