{
  "name": "bakul",
  "version": "0.1.0",
  "private": true,
  "description": "Pasar daring untuk pedagang kecil Indonesia. Logika transaksi asli, uang simulasi.",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace @bakul/shared && concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev --workspace @bakul/api\" \"npm run dev --workspace @bakul/web\"",
    "share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/share.ps1",
    "build": "npm run build --workspace @bakul/shared && npm run build --workspace @bakul/api && npm run build --workspace @bakul/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "audit:a11y": "playwright test e2e/audit-a11y.spec.ts",
    "bukti:ui": "playwright test e2e/bukti-polish.spec.ts",
    "demo:gif": "node scripts/make-demo-gif.mjs",
    "db:generate": "npm run db:generate --workspace @bakul/api",
    "db:migrate": "npm run db:migrate --workspace @bakul/api",
    "db:deploy": "npm run db:deploy --workspace @bakul/api",
    "db:seed": "npm run build --workspace @bakul/shared && npm run db:seed --workspace @bakul/api",
    "db:studio": "npm run db:studio --workspace @bakul/api",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-start.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-stop.ps1",
    "verify:m1": "npm run verify:m1 --workspace @bakul/api",
    "verify:m2": "npm run verify:m2 --workspace @bakul/api",
    "verify:m3": "npm run verify:m3 --workspace @bakul/api",
    "verify:m4": "npm run verify:m4 --workspace @bakul/api",
    "verify:m5": "npm run verify:m5 --workspace @bakul/api",
    "verify:m6": "npm run verify:m6 --workspace @bakul/api",
    "verify:m7": "npm run verify:m7 --workspace @bakul/api",
    "verify:m8": "npm run verify:m8 --workspace @bakul/api",
    "ledger:check": "npm run ledger:check --workspace @bakul/api",
    "demo:reset": "npm run build --workspace @bakul/shared && npm run demo:reset --workspace @bakul/api",
    "postinstall": "npm run db:generate && npm run build --workspace @bakul/shared"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.10.3",
    "concurrently": "10.0.6",
    "gifenc": "1.0.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
